{
  "name": "clarity",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:client": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:client": "vite build",
    "build:test": "node test-build.js",
    "deploy": "npm run build:client && gh-pages -d dist/public",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "setup": "npm install && npm run setup:env",
    "setup:env": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env')) { fs.copyFileSync('.env.example', '.env'); console.log('.env file created from .env.example'); } else { console.log('.env file already exists'); }\"",
    "report:dbms": "node scripts/generate-dbms-report.cjs",
    "report:dbms:open": "npm run report:dbms && node scripts/open-latest-report.cjs",
    "report:json": "node scripts/generate-report-json.cjs",
    "report:json:open": "npm run report:json && node scripts/open-latest-report.cjs"
  },
